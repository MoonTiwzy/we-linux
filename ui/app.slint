// we-linux: окно по раскладке Wallpaper Engine. Шапка с монитором, вкладки
// «Установлено / Рекомендации / Мастерская», поиск, фильтры слева, сетка
// превью со страницами, карточка обоев справа, плейлист и нижние кнопки.

import { ScrollView, LineEdit, Slider } from "std-widgets.slint";

// The interface language: every text is written in both, the window picks.
export global L {
    in-out property <bool> russian;
    pure public function t(english: string, russian-text: string) -> string {
        return self.russian ? russian-text : english;
    }
}

// The hint of the (i) the pointer is over: drawn by the window, over everything.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
}

export global Theme {
    out property <color> bg: #22262b;
    out property <color> well: #191c20;
    out property <color> button: #2d3339;
    out property <color> button-hover: #39414a;
    out property <color> border: #4b535d;
    out property <color> line: #3a4149;
    out property <color> text: #ffffff;
    out property <color> dim: #b6bdc7;
    out property <color> faint: #7d8590;
    out property <color> accent: #2d8ceb;
    out property <color> accent-hover: #4a9ef0;
    out property <color> filtered: #e8a13a;
    out property <color> ok: #6fcf5a;
    out property <color> danger: #e5534b;
}

export struct Item {
    title: string,
    image: image,
    loaded: bool,
    kind: string,
    /// "4K", "HDR", "4K HDR" or "".
    badge: string,
    approved: bool,
    subscribed: bool,
    favorite: bool,
    current: bool,
    /// 0..1 while it downloads, -1 otherwise.
    progress: float,
}

export struct FilterOption {
    label: string,
    checked: bool,
}

export struct FilterGroup {
    title: string,
    open: bool,
    filtered: bool,
    /// Shown in the panel: the filter settings can hide a group, and the
    /// installed wallpapers do not say what some groups ask about.
    shown: bool,
    /// Ticked in the filter settings.
    wanted: bool,
    /// "Показать только": a framed box that is always open.
    boxed: bool,
    options: [FilterOption],
}

export struct PageButton {
    label: string,
    page: int,
    current: bool,
}

/// One user property of the selected wallpaper.
/// kind: 0 bool, 1 slider, 2 color, 3 combo, 4 text input, 5 label, 6 group.
export struct Prop {
    label: string,
    kind: int,
    on: bool,
    number: float,
    min: float,
    max: float,
    text: string,
    options: [string],
    index: int,
    swatch: color,
}

export struct PlaylistEntry {
    title: string,
    image: image,
    loaded: bool,
}

export struct MonitorEntry {
    name: string,
    detail: string,
    wallpaper: string,
}

