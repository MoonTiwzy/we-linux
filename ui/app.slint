component Icon inherits Path {
    in property <string> icon;
    in property <color> tint: Theme.text;
    commands: icon;
    fill: tint;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 16px;
    height: 16px;
}

// Кнопка Wallpaper Engine: тёмная с рамкой, синяя когда главная или активная.
component WeButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> caret;
    in property <length> font: 15px;
    callback clicked;
    horizontal-stretch: 0;
    height: 28px;
    min-width: lay.preferred-width;
    border-radius: 2px;
    border-width: primary ? 0 : 1px;
    border-color: Theme.border;
    opacity: enabled ? 1 : 0.45;
    background: primary ? (ta.has-hover && enabled ? Theme.accent-hover : Theme.accent)
        : ta.has-hover && enabled ? Theme.button-hover : Theme.button;
    lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-size: root.font;
            vertical-alignment: center;
        }
        if root.caret: Icon {
            y: (parent.height - self.height) / 2;
            icon: Icons.caret;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Check inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <color> icon-tint: Theme.text;
    in property <bool> checked;
    callback toggled;
    min-height: 21px;
    HorizontalLayout {
        spacing: 7px;
        alignment: start;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: 2px;
            border-width: 1px;
            border-color: Theme.accent;
            background: root.checked ? Theme.accent : Theme.well;
            if root.checked: Icon {
                x: 0px;
                y: 0px;
                width: 14px;
                height: 14px;
                icon: Icons.check;
            }
        }
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 15px;
            height: 15px;
            icon: root.icon;
            tint: root.icon-tint;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    ta := TouchArea {
        clicked => { root.toggled(); }
    }
}

// Выпадающий список в стиле WE.
component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    callback selected(int);
    height: 30px;
    border-radius: 2px;
    border-width: 1px;
    border-color: Theme.border;
    background: ta.has-hover ? Theme.button-hover : Theme.button;
    Text {
        x: 10px;
        width: parent.width - 34px;
        text: root.index >= 0 && root.index < root.options.length ? root.options[root.index] : "";
        color: Theme.text;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        icon: Icons.caret;
    }
    ta := TouchArea {
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.well;
            VerticalLayout {
                padding: 1px;
                for option[i] in root.options: Rectangle {
                    height: 28px;
                    background: row.has-hover ? Theme.accent : i == root.index ? Theme.button-hover : transparent;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: option;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    row := TouchArea {
                        clicked => {
                            root.index = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

component Cell inherits Rectangle {
    in property <Item> item;
    in property <bool> selected;
    callback clicked;
    callback activated;
    frame := Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 5px;
        height: parent.height - 5px;
        background: #101215;
        clip: true;
        if !root.item.loaded: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 34px;
            height: 34px;
            icon: Icons.image;
            tint: #ffffff18;
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: root.item.image;
            image-fit: cover;
            opacity: root.item.loaded ? 1 : 0;
            animate opacity { duration: 150ms; }
        }
        // Название на полупрозрачной полосе, как в WE.
        Rectangle {
            y: parent.height - self.height;
            height: max(26px, name.preferred-height + 10px);
            background: #000000a0;
            name := Text {
                x: 6px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 12px;
                text: root.item.title;
                color: Theme.text;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
                max-height: 32px;
                overflow: elide;
            }
        }
        HorizontalLayout {
            x: 3px;
            y: 3px;
            height: 18px;
            alignment: start;
            spacing: 3px;
            if root.item.approved: Rectangle {
                width: 20px;
                background: #2e8b3a;
                border-radius: 2px;
                Icon {
                    x: 3px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    icon: Icons.trophy;
                }
            }
            if root.item.subscribed: Rectangle {
                width: 20px;
                background: #000000b0;
                border-radius: 2px;
                Icon {
                    x: 3px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    icon: Icons.save;
                }
            }
            if root.item.favorite: Rectangle {
                width: 20px;
                background: #000000b0;
                border-radius: 2px;
                Icon {
                    x: 3px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    icon: Icons.star;
                    tint: #ffd24a;
                }
            }
            if root.item.current: Rectangle {
                width: now.preferred-width + 10px;
                background: Theme.accent;
                border-radius: 2px;
                now := Text {
                    x: 5px;
                    y: (parent.height - self.height) / 2;
                    text: L.t("on desktop", "на столе");
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 700;
                }
            }
        }
        if root.item.badge != "": Rectangle {
            x: parent.width - self.width - 3px;
            y: 3px;
            width: badge.preferred-width + 8px;
            height: 16px;
            border-radius: 2px;
            background: #e0a020;
            badge := Text {
                x: 4px;
                y: (parent.height - self.height) / 2;
                text: root.item.badge;
                color: #1a1a1a;
                font-size: 10px;
                font-weight: 800;
            }
        }
        if root.item.progress >= 0: Rectangle {
            y: parent.height - 4px;
            height: 4px;
            background: #00000090;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.item.progress, 0, 1);
                background: Theme.accent;
            }
        }
    }
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width - 1px;
        height: parent.height - 1px;
        border-width: 2px;
        border-color: root.selected ? Theme.accent : ta.has-hover ? #ffffff70 : transparent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
    }
}

component PropRow inherits VerticalLayout {
    in property <Prop> prop;
    callback toggled(bool);
    callback number(float);
    callback text(string);
    callback index(int);
    spacing: 3px;
    padding-top: prop.kind == 6 ? 6px : 0px;
    if prop.kind == 6: Text {
        text: prop.label;
        color: Theme.text;
        font-size: 14px;
        font-weight: 700;
        wrap: word-wrap;
    }
    if prop.kind == 5: Text {
        text: prop.label;
        color: Theme.dim;
        font-size: 12px;
        wrap: word-wrap;
    }
    if prop.kind == 0: Check {
        text: prop.label;
        checked: prop.on;
        toggled => { root.toggled(!prop.on); }
    }
    if prop.kind >= 1 && prop.kind <= 4: Text {
        text: prop.label;
        color: Theme.text;
        font-size: 13px;
        wrap: word-wrap;
    }
    if prop.kind == 1: HorizontalLayout {
        spacing: 8px;
        Slider {
            horizontal-stretch: 1;
            minimum: prop.min;
            maximum: prop.max;
            value: prop.number;
            released(value) => { root.number(value); }
        }
        Text {
            width: 46px;
            text: round(prop.number * 100) / 100;
            color: Theme.dim;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if prop.kind == 2: HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 30px;
            height: 26px;
            border-radius: 2px;
            border-width: 1px;
            border-color: Theme.border;
            background: prop.swatch;
        }
        LineEdit {
            horizontal-stretch: 1;
            text: prop.text;
            placeholder-text: "#rrggbb";
            accepted(text) => { root.text(text); }
        }
    }
    if prop.kind == 3: Dropdown {
        options: prop.options;
        index: prop.index;
        selected(i) => { root.index(i); }
    }
    if prop.kind == 4: LineEdit {
        text: prop.text;
        accepted(text) => { root.text(text); }
    }
}

// (i): a hint that shows while the pointer is over it.
component Info inherits Rectangle {
    in property <string> text;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.faint;
    Text {
        text: "i";
        color: ta.has-hover ? Theme.accent : Theme.dim;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.text;
                Tip.x = root.absolute-position.x;
                Tip.y = root.absolute-position.y + 22px;
            } else if Tip.text == root.text {
                Tip.text = "";
            }
        }
    }
}

// A checkbox with its hint.
component Option inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <bool> checked;
    callback toggled;
    spacing: 8px;
    alignment: start;
    Check {
        text: root.text;
        checked: root.checked;
        toggled => { root.toggled(); }
    }
    Info {
        y: (parent.height - self.height) / 2;
        text: root.hint;
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 520px;
    callback closed;
    background: #000000a0;
    TouchArea {
        clicked => { root.closed(); }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.panel-width;
        height: min(parent.height - 80px, body.preferred-height + 54px);
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }
        Text {
            x: 16px;
            y: 12px;
            text: root.title;
            color: Theme.text;
            font-size: 20px;
        }
        Rectangle {
            x: parent.width - 34px;
            y: 10px;
            width: 24px;
            height: 24px;
            background: cross.has-hover ? Theme.button-hover : transparent;
            Icon {
                x: 4px;
                y: 4px;
                icon: Icons.close;
            }
            cross := TouchArea {
                clicked => { root.closed(); }
            }
        }
        body := VerticalLayout {
            x: 16px;
            y: 46px;
            width: parent.width - 32px;
            alignment: start;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "WE Linux";
    preferred-width: 1660px;
    preferred-height: 930px;
    min-width: 1100px;
    min-height: 680px;
    background: Theme.bg;
    default-font-family: "Noto Sans";

    in-out property <int> tab: 2;
    in property <string> monitor-title: L.t("All monitors", "Все мониторы");
    in property <[Item]> items;
    in property <int> selected: -1;
    in property <bool> loading;
    in property <string> error;
    in property <string> status;
    in property <bool> steam-ok;
    in-out property <string> search;
    in property <[string]> sort-options;
    in-out property <int> sort-index;
    in property <[string]> view-options;
    in-out property <int> view-index;
    in-out property <bool> filters-open: true;
    in property <[FilterGroup]> groups;
    in property <bool> filtered;
    in property <[PageButton]> pages;

    in property <bool> has-selection;
    in property <image> sel-image;
    in property <bool> sel-loaded;
    in property <string> sel-title;
    in property <string> sel-facts;
    in property <string> sel-tags;
    in property <float> sel-stars;
    in property <string> sel-description;
    in property <bool> sel-subscribed;
    in property <bool> sel-installed;
    in property <bool> sel-current;
    in property <bool> sel-favorite;
    in property <bool> sel-busy;
    in property <float> sel-progress: -1;
    in property <[Prop]> props;

    in property <[PlaylistEntry]> playlist;
    in property <bool> playlist-running;
    in-out property <int> playlist-minutes: 30;
    in-out property <int> playlist-order;
    in property <[string]> playlist-saved;

    in property <[MonitorEntry]> monitors;
    in-out property <int> monitor-index: -1;

    in-out property <int> set-fps: 60;
    in-out property <int> set-video;
    in-out property <bool> set-mirror;
    in-out property <bool> set-audio;
    in-out property <int> set-volume: 50;
    in-out property <bool> set-freeze: true;
    in-out property <bool> set-stop;
    in-out property <bool> set-still: true;

    /// 0 none, 1 monitors, 2 settings, 3 filter settings, 4 playlist setup, 5 playlist load, 6 mobile.
    in-out property <int> dialog;
    /// 0 English, 1 Русский: the settings' language box.
    in-out property <int> set-lang;
    callback language-picked(int);

    callback tab-changed(int);
    callback view-changed(int);
    callback search-submitted(string);
    callback sort-changed(int);
    callback filter-toggled(int, int);
    callback filter-group-all(int, bool);
    callback group-toggled(int);
    callback group-shown(int);
    callback filters-reset();
    callback page-clicked(int);
    callback item-selected(int);
    callback item-activated(int);
    callback subscribe();
    callback unsubscribe();
    callback apply();
    callback favorite();
    callback open-steam();
    callback open-folder();
    callback reload();
    callback prop-bool(int, bool);
    callback prop-number(int, float);
    callback prop-text(int, string);
    callback prop-index(int, int);
    callback props-reset();
    callback playlist-add();
    callback playlist-remove(int);
    callback playlist-save();
    callback playlist-load(int);
    callback playlist-start();
    callback playlist-stop();
    callback playlist-clear();
    callback monitor-picked(int);
    callback settings-save();
    /// The settings dialog opens: its boxes show what is in force.
    callback settings-shown();
    callback open-file();
    callback accept();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        padding-top: 8px;
        spacing: 8px;

        // ---------------------------------------------------------- монитор
        HorizontalLayout {
            height: 40px;
            spacing: 14px;
            alignment: start;
            Text {
                text: root.monitor-title;
                color: Theme.text;
                font-size: 28px;
                vertical-alignment: center;
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: pick.preferred-width + 20px;
                height: 24px;
                border-radius: 12px;
                background: pick-ta.has-hover ? Theme.button-hover : #3a4047;
                pick := Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    text: L.t("Choose monitor", "Выбрать монитор");
                    color: Theme.text;
                    font-size: 13px;
                }
                pick-ta := TouchArea {
                    clicked => { root.dialog = 1; }
                }
            }
        }

        // ---------------------------------------------------------- вкладки
        VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                height: 28px;
                spacing: 4px;
                WeButton {
                    text: root.view-options.length > 0 ? root.view-options[root.view-index] : L.t("Installed", "Установлено");
                    icon: Icons.save;
                    caret: true;
                    primary: root.tab == 0;
                    font: 17px;
                    clicked => {
                        if (root.tab == 0) {
                            views.show();
                        } else {
                            root.tab = 0;
                            root.tab-changed(0);
                        }
                    }
                    views := PopupWindow {
                        x: 0;
                        y: parent.height;
                        width: 240px;
                        Rectangle {
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.well;
                            VerticalLayout {
                                padding: 1px;
                                for view[i] in root.view-options: Rectangle {
                                    height: 28px;
                                    background: vta.has-hover ? Theme.accent : i == root.view-index ? Theme.button-hover : transparent;
                                    Text {
                                        x: 10px;
                                        text: view;
                                        color: Theme.text;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                    vta := TouchArea {
                                        clicked => {
                                            root.view-index = i;
                                            root.view-changed(i);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                WeButton {
                    text: L.t("Discover", "Рекомендации");
                    icon: Icons.compass;
                    primary: root.tab == 1;
                    font: 17px;
                    clicked => {
                        root.tab = 1;
                        root.tab-changed(1);
                    }
                }
                WeButton {
                    text: L.t("Workshop", "Мастерская");
                    icon: Icons.steam;
                    primary: root.tab == 2;
                    font: 17px;
                    clicked => {
                        root.tab = 2;
                        root.tab-changed(2);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                WeButton {
                    text: L.t("Mobile devices", "Мобильные устройства");
                    icon: Icons.phone;
                    clicked => { root.dialog = 6; }
                }
                WeButton {
                    text: L.t("Monitors", "Мониторы");
                    icon: Icons.monitor;
                    clicked => { root.dialog = 1; }
                }
                WeButton {
                    text: L.t("Settings", "Настройки");
                    icon: Icons.gear;
                    clicked => {
                        root.settings-shown();
                        root.dialog = 2;
                    }
                }
            }
            Rectangle {
                height: 2px;
                background: Theme.accent;
            }
        }

        // ---------------------------------------------------------- тело
        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;

                // поиск, фильтры, сортировка
                HorizontalLayout {
                    height: 32px;
                    spacing: 8px;
                    Rectangle {
                        width: 262px;
                        background: Theme.well;
                        border-width: 1px;
                        border-color: field.has-focus ? Theme.accent : Theme.line;
                        // Clipped: a long query scrolls inside the field, not under the icon.
                        Rectangle {
                            x: 10px;
                            width: parent.width - 44px;
                            clip: true;
                            field := TextInput {
                                // A line of text sits high in its own box: a pixel and a half down.
                                y: 1.5px;
                                height: parent.height;
                                vertical-alignment: center;
                                width: parent.width;
                                text <=> root.search;
                                color: Theme.text;
                                font-size: 14px;
                                single-line: true;
                                accepted => { root.search-submitted(self.text); }
                            }
                        }
                        if root.search == "": Text {
                            x: 10px;
                            y: 1.5px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: L.t("Search", "Поиск");
                            color: Theme.faint;
                            font-size: 14px;
                        }
                        Rectangle {
                            x: parent.width - 30px;
                            width: 30px;
                            Icon {
                                x: 6px;
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                icon: Icons.search;
                            }
                            TouchArea {
                                clicked => { root.search-submitted(root.search); }
                            }
                        }
                    }
                    WeButton {
                        height: 32px;
                        icon: Icons.filter;
                        text: root.filtered ? L.t("Filters (Filtered)", "Фильтры (Отфильтровано)") : L.t("Filters", "Фильтры");
                        primary: root.filters-open;
                        font: 13px;
                        clicked => { root.filters-open = !root.filters-open; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Dropdown {
                        width: 240px;
                        height: 32px;
                        options: root.sort-options;
                        index <=> root.sort-index;
                        selected(i) => { root.sort-changed(i); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    // -------------------------------------------- фильтры
                    if root.filters-open: VerticalLayout {
                        width: 244px;
                        spacing: 6px;
                        WeButton {
                            height: 26px;
                            icon: Icons.reset;
                            text: L.t("Reset filters", "Сбросить фильтры");
                            primary: true;
                            font: 13px;
                            clicked => { root.filters-reset(); }
                        }
                        WeButton {
                            height: 26px;
                            icon: Icons.gear;
                            text: L.t("Filter settings", "Настройки фильтров");
                            font: 13px;
                            clicked => { root.dialog = 3; }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                padding-right: 14px;
                                for group[gi] in root.groups: VerticalLayout {
                                    spacing: 2px;
                                    if group.shown && group.boxed: Rectangle {
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 2px;
                                            Text {
                                                text: group.title + ":";
                                                color: Theme.text;
                                                font-size: 14px;
                                                height: 22px;
                                            }
                                            for option[oi] in group.options: Check {
                                                text: option.label;
                                                icon: oi == 0 ? Icons.trophy : "";
                                                icon-tint: #7ed957;
                                                checked: option.checked;
                                                toggled => { root.filter-toggled(gi, oi); }
                                            }
                                        }
                                    }
                                    if group.shown && !group.boxed: Rectangle {
                                        height: 24px;
                                        Icon {
                                            x: 2px;
                                            y: (parent.height - self.height) / 2;
                                            width: 18px;
                                            height: 18px;
                                            icon: group.open ? Icons.down : Icons.right;
                                        }
                                        HorizontalLayout {
                                            x: 22px;
                                            alignment: start;
                                            spacing: 5px;
                                            Text {
                                                text: group.title;
                                                color: Theme.text;
                                                font-size: 14px;
                                                vertical-alignment: center;
                                            }
                                            if group.filtered: Text {
                                                text: L.t("(Filtered)", "(Отфильтровано)");
                                                color: Theme.filtered;
                                                font-size: 14px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.group-toggled(gi); }
                                        }
                                    }
                                    if group.shown && !group.boxed && group.open && group.options.length > 6: HorizontalLayout {
                                        height: 22px;
                                        padding-left: 14px;
                                        spacing: 14px;
                                        alignment: start;
                                        Text {
                                            text: L.t("All", "Все");
                                            color: Theme.accent;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            TouchArea {
                                                clicked => { root.filter-group-all(gi, true); }
                                            }
                                        }
                                        Text {
                                            text: L.t("None", "Ничего");
                                            color: Theme.accent;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            TouchArea {
                                                clicked => { root.filter-group-all(gi, false); }
                                            }
                                        }
                                    }
                                    if group.shown && !group.boxed && group.open: VerticalLayout {
                                        padding-left: 14px;
                                        for option[oi] in group.options: Check {
                                            text: option.label;
                                            checked: option.checked;
                                            toggled => { root.filter-toggled(gi, oi); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // -------------------------------------------- сетка
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        VerticalLayout {
                            spacing: 6px;
                            grid := ScrollView {
                                vertical-stretch: 1;
                                property <int> cols: max(1, floor((self.visible-width - 2px) / 172px));
                                property <length> cell: (self.visible-width - 2px) / self.cols;
                                content-width: self.visible-width;
                                content-height: ceil(root.items.length / self.cols) * self.cell + 2px;
                                for item[i] in root.items: Cell {
                                    x: mod(i, grid.cols) * grid.cell;
                                    y: floor(i / grid.cols) * grid.cell;
                                    width: grid.cell;
                                    height: grid.cell;
                                    item: item;
                                    selected: i == root.selected;
                                    clicked => { root.item-selected(i); }
                                    activated => { root.item-activated(i); }
                                }
                            }
                            if root.pages.length > 1: HorizontalLayout {
                                height: 24px;
                                alignment: center;
                                spacing: 4px;
                                for page in root.pages: Rectangle {
                                    width: max(22px, label.preferred-width + 10px);
                                    background: page.current || page.page <= 0 ? transparent : pta.has-hover ? Theme.button-hover : Theme.button;
                                    label := Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: page.label;
                                        color: page.current ? Theme.text : page.page > 0 ? Theme.accent : Theme.dim;
                                        font-size: 16px;
                                        font-weight: page.current ? 700 : 400;
                                    }
                                    pta := TouchArea {
                                        enabled: page.page > 0 && !page.current;
                                        clicked => { root.page-clicked(page.page); }
                                    }
                                }
                            }
                        }
                        if root.items.length == 0 || root.loading: Rectangle {
                            background: root.items.length == 0 ? transparent : #22262bc0;
                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                Text {
                                    text: root.loading ? L.t("Loading…", "Загрузка…") : root.error != "" ? root.error
                                        : root.tab == 0 ? L.t("Nothing here yet. Wallpapers show up once you subscribe in the workshop.", "Здесь пусто. Обои появятся после подписки в мастерской.") : L.t("Nothing found", "Ничего не найдено");
                                    color: root.error != "" && !root.loading ? Theme.danger : Theme.dim;
                                    font-size: 17px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                if root.error != "" && !root.loading: HorizontalLayout {
                                    alignment: center;
                                    WeButton {
                                        text: L.t("Retry", "Повторить");
                                        icon: Icons.reset;
                                        clicked => { root.reload(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------------ карточка обоев
            Rectangle {
                width: 330px;
                if !root.has-selection: Text {
                    y: 16px;
                    width: parent.width;
                    text: L.t("Pick a wallpaper", "Выберите обои");
                    color: Theme.dim;
                    font-size: 17px;
                    horizontal-alignment: center;
                }
                if root.has-selection: VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: self.width;
                        background: #101215;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.sel-image;
                            image-fit: contain;
                            opacity: root.sel-loaded ? 1 : 0;
                        }
                    }
                    Text {
                        text: root.sel-title;
                        color: Theme.text;
                        font-size: 18px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        max-height: 52px;
                        overflow: elide;
                    }
                    if root.sel-stars > 0: HorizontalLayout {
                        height: 18px;
                        alignment: center;
                        spacing: 1px;
                        for n in 5: Icon {
                            width: 18px;
                            height: 18px;
                            icon: Icons.star;
                            tint: root.sel-stars >= n + 0.5 ? #ffd24a : #4b535d;
                        }
                    }
                    Text {
                        text: root.sel-facts;
                        color: Theme.dim;
                        font-size: 12px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.sel-progress >= 0: Rectangle {
                        height: 6px;
                        background: Theme.well;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.sel-progress, 0, 1);
                            background: Theme.accent;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        if root.sel-installed: WeButton {
                            horizontal-stretch: 1;
                            primary: true;
                            text: root.sel-current ? L.t("On the desktop", "На рабочем столе") : L.t("Set wallpaper", "Установить обои");
                            clicked => { root.apply(); }
                        }
                        if !root.sel-subscribed && !root.sel-installed: WeButton {
                            horizontal-stretch: 1;
                            primary: true;
                            enabled: !root.sel-busy && root.steam-ok;
                            icon: Icons.plus;
                            text: root.sel-busy ? L.t("Subscribing…", "Подписка…") : L.t("Subscribe", "Подписаться");
                            clicked => { root.subscribe(); }
                        }
                        WeButton {
                            icon: Icons.star;
                            primary: root.sel-favorite;
                            clicked => { root.favorite(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        if root.sel-subscribed: WeButton {
                            horizontal-stretch: 1;
                            enabled: !root.sel-busy && root.steam-ok;
                            text: root.sel-busy ? L.t("Unsubscribing…", "Отписка…") : L.t("Unsubscribe", "Отписаться");
                            font: 13px;
                            clicked => { root.unsubscribe(); }
                        }
                        if !root.sel-subscribed && root.sel-installed: WeButton {
                            horizontal-stretch: 1;
                            enabled: !root.sel-busy && root.steam-ok;
                            text: L.t("Subscribe", "Подписаться");
                            font: 13px;
                            clicked => { root.subscribe(); }
                        }
                        WeButton {
                            horizontal-stretch: 1;
                            icon: Icons.steam;
                            text: L.t("In the workshop", "В мастерской");
                            font: 13px;
                            clicked => { root.open-steam(); }
                        }
                        if root.sel-installed: WeButton {
                            icon: Icons.folder;
                            clicked => { root.open-folder(); }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-right: 14px;
                            if root.props.length > 0: HorizontalLayout {
                                Text {
                                    text: L.t("Properties", "Свойства");
                                    color: Theme.text;
                                    font-size: 16px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                WeButton {
                                    height: 24px;
                                    icon: Icons.reset;
                                    text: L.t("Reset", "Сбросить");
                                    font: 12px;
                                    clicked => { root.props-reset(); }
                                }
                            }
                            for prop[pi] in root.props: PropRow {
                                prop: prop;
                                toggled(v) => { root.prop-bool(pi, v); }
                                number(v) => { root.prop-number(pi, v); }
                                text(v) => { root.prop-text(pi, v); }
                                index(v) => { root.prop-index(pi, v); }
                            }
                            if root.props.length > 0: Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }
                            if root.sel-tags != "": Text {
                                text: root.sel-tags;
                                color: Theme.accent;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.sel-description;
                                color: Theme.dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------- плейлист
        HorizontalLayout {
            height: 40px;
            spacing: 6px;
            Text {
                text: L.t("Playlist", "Плейлист");
                color: Theme.text;
                font-size: 24px;
                vertical-alignment: center;
            }
            Rectangle { width: 8px; }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    height: 26px;
                    spacing: 4px;
                    WeButton {
                        height: 26px;
                        icon: Icons.folder;
                        text: L.t("Load", "Загрузить");
                        clicked => { root.dialog = 5; }
                    }
                    WeButton {
                        height: 26px;
                        icon: Icons.save;
                        text: L.t("Save", "Сохранить");
                        enabled: root.playlist.length > 0;
                        clicked => { root.playlist-save(); }
                    }
                    WeButton {
                        height: 26px;
                        icon: Icons.sliders;
                        text: L.t("Configure", "Настроить");
                        clicked => { root.dialog = 4; }
                    }
                    WeButton {
                        height: 26px;
                        icon: Icons.plus;
                        text: L.t("Add wallpaper", "Добавить обои");
                        primary: true;
                        enabled: root.sel-installed;
                        clicked => { root.playlist-add(); }
                    }
                }
            }
            Rectangle { width: 8px; }
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    for entry[i] in root.playlist: Rectangle {
                        width: 40px;
                        height: 40px;
                        background: #101215;
                        border-width: eta.has-hover ? 1px : 0;
                        border-color: Theme.danger;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: entry.image;
                            image-fit: cover;
                            opacity: entry.loaded ? (eta.has-hover ? 0.35 : 1) : 0;
                        }
                        if eta.has-hover: Icon {
                            x: 12px;
                            y: 12px;
                            icon: Icons.close;
                        }
                        eta := TouchArea {
                            clicked => { root.playlist-remove(i); }
                        }
                    }
                }
            }
            if root.playlist-running: Text {
                text: L.t("running", "идёт");
                color: Theme.ok;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        // ---------------------------------------------------------- нижние кнопки
        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            WeButton {
                width: 250px;
                icon: Icons.tools;
                text: L.t("Wallpaper Editor", "Редактор обоев");
                primary: true;
                enabled: false;
            }
            WeButton {
                width: 250px;
                icon: Icons.upload;
                text: L.t("Open wallpaper", "Открыть обои");
                clicked => { root.open-file(); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: Theme.dim;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
            WeButton {
                width: 96px;
                text: "OK";
                primary: true;
                clicked => { root.accept(); }
            }
            WeButton {
                width: 96px;
                text: L.t("Cancel", "Отмена");
                clicked => { root.cancel(); }
            }
        }
    }

    // -------------------------------------------------------------- диалоги
    if root.dialog == 1: Dialog {
        title: L.t("Monitors", "Мониторы");
        closed => { root.dialog = 0; }
        Text {
            text: L.t("Pick the monitor wallpapers go to. \"All monitors\" puts one wallpaper on every monitor.", "Выбери, на какой монитор ставятся обои. «Все мониторы» ставит одни обои на все.");
            color: Theme.dim;
            font-size: 13px;
            wrap: word-wrap;
        }
        Rectangle { height: 8px; }
        Rectangle {
            height: 44px;
            border-width: root.monitor-index == -1 ? 2px : 1px;
            border-color: root.monitor-index == -1 ? Theme.accent : Theme.line;
            background: all-ta.has-hover ? Theme.button-hover : Theme.well;
            Text {
                x: 12px;
                text: L.t("All monitors", "Все мониторы");
                color: Theme.text;
                font-size: 15px;
                vertical-alignment: center;
            }
            all-ta := TouchArea {
                clicked => {
                    root.monitor-index = -1;
                    root.monitor-picked(-1);
                }
            }
        }
        for mon[i] in root.monitors: VerticalLayout {
            padding-top: 6px;
            Rectangle {
                height: 52px;
                border-width: root.monitor-index == i ? 2px : 1px;
                border-color: root.monitor-index == i ? Theme.accent : Theme.line;
                background: mta.has-hover ? Theme.button-hover : Theme.well;
                Text {
                    x: 12px;
                    y: 7px;
                    text: L.t("Monitor ", "Монитор ") + (i + 1) + "  ·  " + mon.name + "  ·  " + mon.detail;
                    color: Theme.text;
                    font-size: 15px;
                }
                Text {
                    x: 12px;
                    y: 29px;
                    width: parent.width - 24px;
                    text: mon.wallpaper;
                    color: Theme.dim;
                    font-size: 12px;
                    overflow: elide;
                }
                mta := TouchArea {
                    clicked => {
                        root.monitor-index = i;
                        root.monitor-picked(i);
                    }
                }
            }
        }
        Rectangle { height: 12px; }
    }

    // The first run: the language, before anything else.
    if root.dialog == 9: Dialog {
        title: "Language · Язык";
        panel-width: 360px;
        HorizontalLayout {
            spacing: 10px;
            WeButton {
                horizontal-stretch: 1;
                height: 40px;
                text: "English";
                primary: !L.russian;
                clicked => { root.language-picked(0); }
            }
            WeButton {
                horizontal-stretch: 1;
                height: 40px;
                text: "Русский";
                primary: L.russian;
                clicked => { root.language-picked(1); }
            }
        }
        Rectangle { height: 14px; }
    }

    if root.dialog == 2: Dialog {
        title: L.t("Settings", "Настройки");
        closed => { root.dialog = 0; }
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Text {
                width: 190px;
                text: "Language · Язык";
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
            Dropdown {
                horizontal-stretch: 1;
                options: ["English", "Русский"];
                index <=> root.set-lang;
            }
        }
        Rectangle { height: 10px; }
        Text {
            text: L.t("Performance", "Производительность");
            color: Theme.text;
            font-size: 16px;
        }
        Rectangle { height: 6px; }
        HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Text {
                width: 164px;
                text: L.t("Frames per second", "Кадров в секунду");
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
            Info {
                y: (parent.height - self.height) / 2;
                text: L.t("The wallpaper's frame rate cap. 30 roughly halves the processor and GPU work.", "Потолок кадров обоев. 30 примерно вдвое снижает нагрузку на процессор и видеокарту.");
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 10;
                maximum: 165;
                value: root.set-fps;
                changed(v) => { root.set-fps = round(v); }
            }
            Text {
                width: 40px;
                text: root.set-fps;
                color: Theme.dim;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Text {
                width: 164px;
                text: L.t("Videos inside scenes", "Видео внутри сцен");
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
            Info {
                y: (parent.height - self.height) / 2;
                text: L.t("Where videos inside scenes are decoded. Processor: little video memory, more processor load. Graphics card: less processor load, but a 4K video can take about 1 GB of video memory.", "Где декодируются видео внутри сцен. Процессор: мало видеопамяти, больше нагрузка на процессор. Видеокарта: меньше нагрузка на процессор, но 4K-видео может занять около 1 ГБ видеопамяти.");
            }
            Dropdown {
                horizontal-stretch: 1;
                options: [L.t("Processor", "Процессор"), L.t("Graphics card", "Видеокарта")];
                index <=> root.set-video;
            }
        }
        Rectangle { height: 4px; }
        Option {
            text: L.t("One render for all monitors", "Один рендер на все мониторы");
            hint: L.t("The scene is drawn once and shown on every monitor: about half the memory and work, but scripts see one pointer for all monitors.", "Сцена рисуется один раз и показывается на всех мониторах: примерно вдвое меньше памяти и работы, но скрипты видят один курсор на все мониторы.");
            checked: root.set-mirror;
            toggled => { root.set-mirror = !root.set-mirror; }
        }
        Rectangle { height: 10px; }
        Text {
            text: L.t("Fullscreen", "Полный экран");
            color: Theme.text;
            font-size: 16px;
        }
        Rectangle { height: 6px; }
        Option {
            text: L.t("Freeze under fullscreen windows", "Замораживать под полноэкранными окнами");
            hint: L.t("Hyprland. A monitor that shows a fullscreen window keeps the wallpaper's last frame and does no work; the wallpaper goes on from that frame when the desktop is back.", "Hyprland. На мониторе с полноэкранным окном обои замирают на последнем кадре и ничего не считают, а когда рабочий стол снова виден, идут дальше с этого кадра.");
            checked: root.set-freeze;
            toggled => { root.set-freeze = !root.set-freeze; }
        }
        Option {
            text: L.t("Stop the engine when every monitor is fullscreen", "Останавливать движок, когда все мониторы в полном экране");
            hint: L.t("Hyprland. Frees the video memory for a game. The scene starts over when the desktop is back.", "Hyprland. Освобождает видеопамять для игры. Когда рабочий стол снова виден, сцена начинается заново.");
            checked: root.set-stop;
            toggled => { root.set-stop = !root.set-stop; }
        }
        Rectangle { height: 10px; }
        Text {
            text: L.t("Desktop", "Рабочий стол");
            color: Theme.text;
            font-size: 16px;
        }
        Rectangle { height: 6px; }
        Option {
            text: L.t("Still frame for awww, swww or hyprpaper", "Стоп-кадр для awww, swww или hyprpaper");
            hint: L.t("Gives your static wallpaper program a frame of the live wallpaper, so the desktop shows it before the engine starts and while it is stopped.", "Отдаёт программе статичных обоев кадр живых обоев: рабочий стол показывает его, пока движок не запустился и пока он остановлен.");
            checked: root.set-still;
            toggled => { root.set-still = !root.set-still; }
        }
        Rectangle { height: 10px; }
        Text {
            text: L.t("Sound", "Звук");
            color: Theme.text;
            font-size: 16px;
        }
        Rectangle { height: 6px; }
        Option {
            text: L.t("Wallpaper sound", "Звук обоев");
            hint: L.t("Plays the wallpaper's own sound and lets scenes react to the music you play.", "Включает собственный звук обоев и реакцию сцен на музыку, которую ты слушаешь.");
            checked: root.set-audio;
            toggled => { root.set-audio = !root.set-audio; }
        }
        HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Text {
                width: 190px;
                text: L.t("Volume", "Громкость");
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 100;
                value: root.set-volume;
                changed(v) => { root.set-volume = round(v); }
            }
            Text {
                width: 40px;
                text: root.set-volume;
                color: Theme.dim;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        Rectangle { height: 14px; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            WeButton {
                width: 110px;
                text: L.t("Apply", "Применить");
                primary: true;
                clicked => {
                    root.settings-save();
                    root.dialog = 0;
                }
            }
            WeButton {
                width: 96px;
                text: L.t("Cancel", "Отмена");
                clicked => { root.dialog = 0; }
            }
        }
        Rectangle { height: 12px; }
    }

    if root.dialog == 3: Dialog {
        title: L.t("Filter settings", "Настройки фильтров");
        panel-width: 380px;
        closed => { root.dialog = 0; }
        Text {
            text: L.t("Sections shown in the filter panel:", "Какие разделы показывать в панели фильтров:");
            color: Theme.dim;
            font-size: 13px;
            wrap: word-wrap;
        }
        Rectangle { height: 6px; }
        for group[gi] in root.groups: Check {
            text: group.title;
            checked: group.wanted;
            toggled => { root.group-shown(gi); }
        }
        Rectangle { height: 12px; }
    }

    if root.dialog == 4: Dialog {
        title: L.t("Playlist settings", "Настройка плейлиста");
        closed => { root.dialog = 0; }
        HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Text {
                width: 190px;
                text: L.t("Change wallpaper every, min", "Менять обои каждые, мин");
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
            Slider {
                horizontal-stretch: 1;
                minimum: 1;
                maximum: 240;
                value: root.playlist-minutes;
                changed(v) => { root.playlist-minutes = round(v); }
            }
            Text {
                width: 40px;
                text: root.playlist-minutes;
                color: Theme.dim;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Text {
                width: 190px;
                text: L.t("Order", "Порядок");
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
            Dropdown {
                horizontal-stretch: 1;
                options: [L.t("In order", "По порядку"), L.t("Random", "Случайный")];
                index <=> root.playlist-order;
            }
        }
        Rectangle { height: 6px; }
        Text {
            text: L.t("Wallpapers in the playlist: ", "В плейлисте обоев: ") + root.playlist.length + (root.playlist-running ? L.t(". The playlist is running.", ". Плейлист идёт.") : L.t(". The playlist is stopped.", ". Плейлист остановлен."));
            color: Theme.dim;
            font-size: 13px;
        }
        Rectangle { height: 12px; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            WeButton {
                text: L.t("Clear", "Очистить");
                enabled: root.playlist.length > 0;
                clicked => { root.playlist-clear(); }
            }
            if root.playlist-running: WeButton {
                width: 130px;
                text: L.t("Stop", "Остановить");
                clicked => {
                    root.playlist-stop();
                    root.dialog = 0;
                }
            }
            WeButton {
                width: 130px;
                text: root.playlist-running ? L.t("Restart", "Перезапустить") : L.t("Start", "Запустить");
                primary: true;
                enabled: root.playlist.length > 0;
                clicked => {
                    root.playlist-start();
                    root.dialog = 0;
                }
            }
        }
        Rectangle { height: 12px; }
    }

    if root.dialog == 5: Dialog {
        title: L.t("Load a playlist", "Загрузить плейлист");
        panel-width: 380px;
        closed => { root.dialog = 0; }
        if root.playlist-saved.length == 0: Text {
            text: L.t("No saved playlists. Build one with \"Add wallpaper\" and press \"Save\".", "Сохранённых плейлистов нет. Собери плейлист кнопкой «Добавить обои» и нажми «Сохранить».");
            color: Theme.dim;
            font-size: 13px;
            wrap: word-wrap;
        }
        for name[i] in root.playlist-saved: VerticalLayout {
            padding-top: 4px;
            Rectangle {
                height: 32px;
                border-width: 1px;
                border-color: Theme.line;
                background: sta.has-hover ? Theme.accent : Theme.well;
                Text {
                    x: 10px;
                    text: name;
                    color: Theme.text;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                sta := TouchArea {
                    clicked => {
                        root.playlist-load(i);
                        root.dialog = 0;
                    }
                }
            }
        }
        Rectangle { height: 12px; }
    }

    if root.dialog == 6: Dialog {
        title: L.t("Mobile devices", "Мобильные устройства");
        panel-width: 420px;
        closed => { root.dialog = 0; }
        Text {
            text: L.t("Sending wallpapers to a phone works only with the Wallpaper Engine app for Android and its own pairing protocol. That is not here.", "Передача обоев на телефон работает только с приложением Wallpaper Engine для Android и его собственным протоколом сопряжения. Здесь этого нет.");
            color: Theme.dim;
            font-size: 13px;
            wrap: word-wrap;
        }
        Rectangle { height: 14px; }
    }
    // The hint of an (i), over the dialogs.
    if Tip.text != "": Rectangle {
        x: max(8px, min(Tip.x - 12px, root.width - self.width - 8px));
        y: min(Tip.y, root.height - self.height - 8px);
        width: 340px;
        height: hint.preferred-height + 18px;
        background: #11151c;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: 3px;
        hint := Text {
            x: 11px;
            y: 9px;
            width: parent.width - 22px;
            text: Tip.text;
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
