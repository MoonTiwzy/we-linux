/// An icon, as tall as a letter of .
export component Icon inherits Path {
    in property <Glyph> glyph;
    in property <color> tint: Theme.text;
    in property <length> size: 14px;
    commands: glyph.d;
    fill: tint;
    viewbox-width: glyph.w;
    viewbox-height: 512;
    height: size;
    width: size * glyph.w / 512;
}
